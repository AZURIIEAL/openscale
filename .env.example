# Settings for docker-compose.deploy.yml. Copy to .env (never committed).

# Required. Everyone who uses this OpenScale signs in with it.
OPENSCALE_PASSWORD=

# The user name for that sign-in.
OPENSCALE_USER=openscale

# ":80" serves plain HTTP on any address (use this behind Cloudflare's proxy
# or a Cloudflare Tunnel). A domain, e.g. openscale.example.com, makes the
# gateway get its own HTTPS certificate: point the domain's DNS at this
# machine and open ports 80 and 443 first.
OPENSCALE_SITE=:80
